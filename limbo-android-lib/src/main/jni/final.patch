-static void kvm_irqchip_create(KVMState *s)
-{
-    int ret;
-
-    assert(s->kernel_irqchip_split != ON_OFF_AUTO_AUTO);
-    if (kvm_check_extension(s, KVM_CAP_IRQCHIP)) {
-        ;
