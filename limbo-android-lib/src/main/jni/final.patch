-    QTAILQ_FOREACH(con, &consoles, next) {
-        if (con->hw_ops != &unused_ops) {
-            continue;
-        }
-        obj = object_property_get_link(OBJECT(con),
-                                       "device", &error_abort);
-        if (obj != NULL) {
-            continue;
-        }
-        return con;
-    }
-    return NULL;
-}
